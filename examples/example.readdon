{
    "version":3,
    "metadata": {
        "name": "MyCustomReWidgetsAddon",
        "author": "..."
    },

    "widgets": [
        {
            "name": "MyCustomWidget",
            "label": "My Custom Widget",
            "description": "An example widget definition demonstrating every available-properties field type.",
            "callbacks" : {
                "onRegister": "cl_onWidgetRegister",
                "onCreate": "cl_onWidgetCreate",
                "onDestroy": "cl_onWidgetDestroy",
                "onUpdate": "cl_onWidgetUpdate",
                "onCallback": "cl_onWidgetCallback"
            },
            "available-properties": {
                "MyProperty": {
                    "default": "<default value>",
                    "label": "Additional Property",
                    "description": "An additional property that does smth.",
                    "type": "string"
                },
                "MyOtherProperty": {
                    "default": "<default value>",
                    "label": "Additional Property",
                    "description": "An additional property that does smth.",
                    "type": "integer",
                    "parent": "MyProperty"
                }
            },
            "required-callbacks": {
                "onSomething": {
                    "default": "<default callback if available, otherwise leave empty>",
                    "description": "Callback to do something."
                }
            },
            "available-callbacks": {
                "onSomething": {
                    "description": "Callback to do something."
                },
                "onSomething2": {
                    "description": "Callback to do something."
                }
            }
        }
    ]
}
