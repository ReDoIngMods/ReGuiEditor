<?xml version='1.0' encoding='utf-8'?>
<!--
The overlay (selection handles, canvas background) and the unmatched-skin
fallback used to reuse the game's own "GenericButton" skin, tinted via
Widget::setColour(). That rendered solid black no matter the tint: MyGUI
multiplies the skin's texture colour by the tint, and GenericButton's
actual pixels at the sampled offsets are dark/black, so tint * black stays
black regardless of the tint value. editor-white.png is a plain white 4x4
texture, so tinting this skin actually produces the requested colour.
-->
<MyGUI type="Resource" version="1.1">
    <Resource type="ResourceSkin" name="EditorFlatColour" size="4 4" texture="editor-white.png">
        <BasisSkin type="SubSkin" offset="0 0 4 4" align="Stretch">
            <State name="normal" offset="0 0 4 4"/>
        </BasisSkin>
    </Resource>
</MyGUI>
