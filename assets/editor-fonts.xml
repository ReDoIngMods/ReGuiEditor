<?xml version='1.0' encoding='utf-8'?>
<!--
Loading the game's own Language/English/Fonts.xml wholesale (~90 fonts,
several with huge CJK glyph atlases up to 4096x2048) made every canvas
realize take long enough to look like the app had hung. This is a small,
project-owned manifest (not a copy of the game's own file) with just the
handful of Latin-only fonts the editor's own widget-name labels actually
need, referencing the same font files under Fonts/ - extend this list if a
later feature needs another one, rather than switching back to the full set.
-->
<MyGUI type="Resource" version="1.1">
    <Resource type="ResourceTrueTypeFont" name="SM_Label">
        <Property key="Source" value="GRUPO3.otf" />
        <Property key="Size" value="9" />
        <Property key="LetterSpacing" value="0.66666667" />
    </Resource>
    <Resource type="ResourceTrueTypeFont" name="SM_TextLabel">
        <Property key="Source" value="Shentox_Medium.otf" />
        <Property key="Size" value="9" />
    </Resource>
    <Resource type="ResourceTrueTypeFont" name="SM_Text">
        <Property key="Source" value="Inter_Medium.otf" />
        <Property key="Size" value="10" />
    </Resource>
    <Resource type="ResourceTrueTypeFont" name="SM_TextSmall">
        <Property key="Source" value="Inter_Medium.otf" />
        <Property key="Size" value="8" />
    </Resource>
    <Resource type="ResourceTrueTypeFont" name="SM_Header">
        <Property key="Source" value="Shentox_SemiBold.otf" />
        <Property key="Size" value="9" />
        <Property key="LetterSpacing" value="1.33333333" />
    </Resource>
    <Resource type="ResourceTrueTypeFont" name="SM_HeaderSmall">
        <Property key="Source" value="Shentox_SemiBold.otf" />
        <Property key="Size" value="8" />
        <Property key="LetterSpacing" value="1.33333333" />
    </Resource>
    <Resource type="ResourceTrueTypeFont" name="SM_Button">
        <Property key="Source" value="Shentox_SemiBold.otf" />
        <Property key="Size" value="10" />
        <Property key="LetterSpacing" value="0.66666667" />
    </Resource>
    <Resource type="ResourceTrueTypeFont" name="SM_ButtonSmall">
        <Property key="Source" value="Shentox_SemiBold.otf" />
        <Property key="Size" value="8" />
    </Resource>
    <Resource type="ResourceTrueTypeFont" name="SM_ListItem">
        <Property key="Source" value="Shentox_SemiBold.otf" />
        <Property key="Size" value="9" />
    </Resource>
    <Resource type="ResourceTrueTypeFont" name="SM_ToolTipText">
        <Property key="Source" value="Shentox_Medium.otf" />
        <Property key="Size" value="8" />
    </Resource>
</MyGUI>
