{
    "version":3,
    "metadata": {
        "name": "MyCustomReWidgetsAddon",
    },

    "widgets": [
        {
            "name": "MyCustomWidget",
            "label": "My Custom Widget",
            "description": "An example widget definition demonstrating every available-properties field type.",
            "icon":"<put a testing base64 encoded icon here>",
            "callbacks" : {
                "onRegister": "cl_onWidgetRegister",
                "onCreate": "cl_onWidgetCreate",
                "onDestroy": "cl_onWidgetDestroy",
                "onUpdate": "cl_onWidgetUpdate",
                "onCallback": "cl_onWidgetCallback"
            },
            "available-properties": {
                "MyProperty": {
                    "default": "<default value>",
                    "label": "Additional Property",
                    "description": "An additional property that does smth.",
                    "type": "string"
                },
                "MyOtherProperty": {
                    "default": "<default value>",
                    "label": "Additional Property",
                    "description": "An additional property that does smth.",
                    "type": "string"
                },
                "MyCount": {
                    "default": 0,
                    "label": "Count",
                    "description": "An example integer property.",
                    "type": "integer"
                },
                "MyRatio": {
                    "default": 0,
                    "label": "Ratio",
                    "description": "An example float property.",
                    "type": "float"
                },
                "MyFlag": {
                    "default": false,
                    "label": "Flag",
                    "description": "An example boolean property.",
                    "type": "bool"
                },
                "MyTargetWidget": {
                    "default": "",
                    "label": "Target Widget",
                    "description": "An example widget-reference property, picked from the other widgets in the layout.",
                    "type": "widget"
                },
                "MyChoice": {
                    "default": "First",
                    "label": "Choice",
                    "description": "An example enum property - picked from a fixed list of values.",
                    "type": "enum",
                    "values": ["First", "Second", "Third"]
                },
                "MyLabel": {
                    "label": "Label",
                    "description": "An example section - Size/Font Scale below are its sub-properties. Has no \"default\", so it's a pure grouping header rather than an editable field."
                },
                "MyLabelSize": {
                    "default": 12,
                    "label": "Size",
                    "description": "The label's font size.",
                    "type": "integer",
                    "parent": "MyLabel"
                },
                "MyLabelFontScale": {
                    "default": 1.0,
                    "label": "Font Scale",
                    "description": "The label's font scale multiplier.",
                    "type": "float",
                    "parent": "MyLabel"
                }
            },
            "required-callbacks": {
                "onSomething": {
                    "default": "<default callback if available, otherwise leave empty>",
                    "description": "Callback to do something."
                }
            },
            "available-callbacks": {
                "onSomething": {
                    "description": "Callback to do something."
                },
                "onSomething2": {
                    "description": "Callback to do something."
                }
            }
        }
    ]
}
