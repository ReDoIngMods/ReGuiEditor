{
    "version":3,
    "metadata": {
        "name": "sm.regui Builtins"
    },

    "widgets": [
        {
            "name": "ReGui.TextLabel",
            "label": "Text Label",
            "description": "A single-line (or wrapped) block of static text.",
            "icon":"",
            "available-properties": {
                "text": {
                    "default": "Text...",
                    "label": "Text Displayed",
                    "description": "The text to be displayed by the label.",
                    "type": "string"
                }
            },
            "required-callbacks": {},
            "available-callbacks": {}
        },
        {
            "name": "ReGui.Frame",
            "label": "Frame",
            "description": "An empty rectangular container used to group or frame other widgets.",
            "icon":"",
            "available-properties": {},
            "required-callbacks": {},
            "available-callbacks": {}
        },
        {
            "name": "ReGui.Button",
            "label": "Button",
            "description": "A clickable button with a text label.",
            "icon":"",
            "available-properties": {
                "text-label": {
                    "default": "Label...",
                    "label": "Text Label",
                    "description": "The text to be displayed on the button.",
                    "type": "string"
                }
            },
            "required-callbacks": {},
            "available-callbacks": {}
        },
        {
            "name": "ReGui.EditBox",
            "label": "Edit Box",
            "description": "A single or multi-line text input field.",
            "icon": "",
            "available-properties": {
                "text-label": {
                    "default": "Text...",
                    "label": "Text",
                    "description": "The text displayed/entered in the EditBox",
                    "type": "string"
                },
                "font-name": {
                    "default": "Default",
                    "label": "Font Name",
                    "description": "The font used to render the text",
                    "type": "string"
                },
                "text-align": {
                    "default": "Left",
                    "label": "Text Alignment",
                    "description": "The alignment of the text",
                    "type": "enum",
                    "values": ["Left", "Center", "Right"]
                },
                "text-colour": {
                    "default": "#FFFFFFFF",
                    "label": "Text Colour",
                    "description": "The colour of the text",
                    "type": "colour"
                },
                "max-text-length": {
                    "default": 0,
                    "label": "Maximum Text Length",
                    "description": "Maximum number of characters allowed",
                    "type": "integer"
                },
                "read-only": {
                    "default": false,
                    "label": "Read Only",
                    "description": "Prevents editing of the text",
                    "type": "boolean"
                },
                "multi-line": {
                    "default": false,
                    "label": "Multi Line",
                    "description": "Allows multiple lines of text",
                    "type": "boolean"
                },
                "word-wrap": {
                    "default": false,
                    "label": "Word Wrap",
                    "description": "Wraps text to the available width",
                    "type": "boolean"
                },
                "password": {
                    "default": false,
                    "label": "Password",
                    "description": "Masks the entered text",
                    "type": "boolean"
                }
            },
            "required-callbacks": {},
            "available-callbacks": {}
        },
        {
            "name": "ReGui.Image",
            "label": "Image",
            "description": "An image display widget.",
            "icon":"",
            "available-properties": {
                "ImageResource": {
                    "default": "$CONTENT_<UUID>/Path/To/Image.png",
                    "label": "Image Resource",
                    "description": "The image file to be displayed.",
                    "type": "string"
                },
                "ImageCoord": {
                    "label": "Image Coordinates",
                    "description": "The rectangle to specifically show from the image.",
                    "type": "group",
                    "properties": [
                        {
                            "description": "The X coordinate of the rectangle.",
                            "label": "X",
                            "type": "integer",
                            "default": 0
                        },
                        {
                            "description": "The Y coordinate of the rectangle.",
                            "label": "Y",
                            "type": "integer",
                            "default": 0
                        }
                    ]
                }
            
            },
            "required-callbacks": {},
            "available-callbacks": {}
        }
    ]
}
